---
import '../styles/site.css';
import home from '../data/startseite.json';

const { title = 'Harry Hollywood', bodyClass, noindex = false } = Astro.props;
const hide = noindex || home.seo.hideFromSearch;
---
<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={home.seo.description}>
<meta property="og:title" content={title}>
<meta property="og:description" content={home.seo.shareText}>
<meta property="og:type" content="website">
<meta name="theme-color" content="#00B140">
{hide && <meta name="robots" content="noindex">}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2300B140'/%3E%3Cpath d='M8 7h5v7h6V7h5v18h-5v-7h-6v7H8z' fill='%2308110C'/%3E%3C/svg%3E">
</head>
<body class={bodyClass}>
<slot />
</body>
</html>
